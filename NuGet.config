<?xml version="1.0" encoding="utf-8"?>
<!--
  This project has no NuGet dependencies: it references the game's own Unity/BepInEx assemblies.
  Clearing the package sources makes `dotnet build` work fully offline and stops it from failing
  when nuget.org is unreachable or a machine-wide source is misconfigured.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
