<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This project is deliberately restore-free and targeting-pack-free.

      * It compiles against the base class libraries Unity ships in the game's Managed folder
        (mscorlib/System/System.Core/netstandard), which are exactly the assemblies the game
        will run it against.
      * DisableImplicitFrameworkReferences stops the SDK adding an implicit NETStandard.Library
        package reference (NU1100 when NuGet is unreachable).
      * netstandard2.0 is used rather than net472 purely because .NETFramework target
        frameworks make MSBuild demand a Developer Pack / targeting pack that isn't installed
        on most machines (MSB3644). The emitted IL is loadable by the game's Mono runtime
        either way.

      Net result: it builds offline, with nothing installed but the .NET SDK.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <!-- Belt and braces: keeps MSB3644 quiet if anything still asks for reference assemblies. -->
    <_TargetFrameworkDirectories>$(MSBuildThisFileDirectory)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(MSBuildThisFileDirectory)</_FullFrameworkReferenceAssemblyPaths>
    <AssemblyName>SeaPowerNightVision</AssemblyName>
    <RootNamespace>SeaPowerNightVision</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyTitle>Sea Power Night Vision</AssemblyTitle>
    <Product>Sea Power Night Vision</Product>
    <Description>Toggleable night vision mode for Sea Power: Naval Combat in the Missile Age.</Description>
  </PropertyGroup>

  <!--
    Where your copy of the game lives. Override on the command line, e.g.

      dotnet build src/SeaPowerNightVision/SeaPowerNightVision.csproj -c Release ^
        /p:GameDir="D:\SteamLibrary\steamapps\common\Sea Power"

    The default is the usual Steam install path on Windows.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</GameDir>
    <ManagedDir>$(GameDir)\Sea Power_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <!-- Set /p:CopyToPlugins=false to skip the post-build copy. -->
    <CopyToPlugins Condition="'$(CopyToPlugins)' == ''">true</CopyToPlugins>
    <!-- Set /p:AnchorChain=true (and AnchorChainDll=...) to also build the Anchor Chain entry point. -->
    <AnchorChain Condition="'$(AnchorChain)' == ''">false</AnchorChain>
    <AnchorChainDll Condition="'$(AnchorChainDll)' == ''">$(GameDir)\BepInEx\plugins\AnchorChain.dll</AnchorChainDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AnchorChain)' == 'true'">
    <DefineConstants>$(DefineConstants);ANCHORCHAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base class libraries, taken from Unity's own Mono profile in the game folder. -->
    <Reference Include="mscorlib">
      <HintPath>$(ManagedDir)\mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(ManagedDir)\System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(ManagedDir)\System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard" Condition="Exists('$(ManagedDir)\netstandard.dll')">
      <HintPath>$(ManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FontStyle / TextAnchor, used by the on-screen NVG readout. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(AnchorChain)' == 'true'">
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="Could not find the game's Managed folder at '$(ManagedDir)'. Pass the install path with /p:GameDir=&quot;...\Sea Power&quot;." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')"
           Text="Could not find BepInEx at '$(BepInExCoreDir)'. Install BepInEx 5.4.x into the game folder and run the game once." />
  </Target>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(CopyToPlugins)' == 'true' AND Exists('$(GameDir)\BepInEx')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SeaPowerNightVision" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\SeaPowerNightVision" />
    <Message Importance="high" Text="Copied $(TargetFileName) -> $(GameDir)\BepInEx\plugins\SeaPowerNightVision" />
  </Target>

</Project>
